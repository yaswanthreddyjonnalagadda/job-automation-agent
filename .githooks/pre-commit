#!/bin/sh
# Every change reaches main through a branch and a pull request (RFC-001, M0),
# whoever makes it -- you, Claude Code or any other coding agent.
# Turn this on once per clone:   git config core.hooksPath .githooks
branch=$(git symbolic-ref --short -q HEAD)
case "$branch" in
  main|master)
    echo "Not committing on '$branch': changes go on a branch and reach $branch by pull request." >&2
    echo "  git switch -c fix/<what-it-fixes>" >&2
    exit 1
    ;;
esac
# A committed file must not import a project module that is not committed (28 September).
py=python; [ -x venv/Scripts/python.exe ] && py=venv/Scripts/python.exe; [ -x venv/bin/python ] && py=venv/bin/python
"$py" .githooks/check_imports.py || exit 1
# Bug-finding style rules (ruff.toml): about a second. Skipped, with a notice, only where ruff is not installed.
if "$py" -m ruff --version >/dev/null 2>&1; then
  "$py" -m ruff check . || exit 1
else
  echo "pre-commit: ruff is not installed here (pip install -r requirements-dev.txt), the style check was not run" >&2
fi
# A change must not alter how the pages already met are read or answered without saying so (29 September: a fix
# for one portal kept breaking another). Replays every saved page with the last commit and with what is staged;
# a difference blocks the commit until it is confirmed a correction:  REPLAY_OK=1 git commit ...
"$py" replay_guard.py || exit 1
# The repository's own audits fail a change that CI would fail for style, not behaviour: a swallowed exception, a
# place literal in logic, an incomplete failure note (2 November: main went red on three of these, found after the
# merge). They take about 20 seconds; skipped, with a notice, only where pytest is not installed.
if "$py" -c "import pytest" 2>/dev/null; then
  "$py" -m pytest -q -p no:cacheprovider tests/test_no_silent_swallow.py tests/test_no_place_literals.py     tests/test_failures_catalogue.py tests/test_next_project_knowledge.py || exit 1
else
  echo "pre-commit: pytest is not installed here, the audits were not run" >&2
fi
exit 0
