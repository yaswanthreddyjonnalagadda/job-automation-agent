# Secrets: Anthropic API key, ATS account password, Postgres password.
.env

# Logged-in browser session (cookies for your employer ATS accounts).
browser_profile/

# Generated per-application materials and scratch state.
output/
logs/
data/*.db
data/_*.json
data/_*.txt

# Explicit answers for employer-specific questions. This is personal data and
# may include legal, demographic, salary, and availability answers.
data/profile_answers.json
data/profile.json
# The questions the agent could not answer: which employers you applied to, and why.
data/unanswered_questions.json
# The same questions and the failure notes as one file for the next project (next_project_knowledge.py).
data/next_project_knowledge.json

__pycache__/
*.py[cod]
venv/

# Your resume and any other personal documents dropped in data/.
data/*.pdf
data/*.docx
data/*.doc

# Editor/tool scratch.
.pytest_cache/
.hypothesis/
.vscode/

# Forensic dumps from the circuit breaker (state_machine.py): page HTML and
# screenshots of real application forms, which carry personal answers.
runs/

# Virtual environments under either common name.
.venv/

# Run logs: they name employers and carry answers.
data/*.log
