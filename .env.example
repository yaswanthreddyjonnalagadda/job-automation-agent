# Copy this file to .env and fill in your Anthropic API key.
# Do NOT put a LinkedIn/Indeed/Dice password here -- those three are
# hard-blocked from scripted login regardless of what's in this file.
# See SETUP_GUIDE.md.

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Employer ATS account (Workday/Greenhouse/Lever/iCIMS) credentials only --
# a dedicated password you use across these employer-owned application
# portals, NOT your email password and NOT a LinkedIn/Indeed/Dice password.
ATS_EMAIL=you@example.com
ATS_PASSWORD=

# Optional overrides:
# RESUME_PATH=./data/resume.pdf
# JOB_QUEUE_PATH=./data/job_queue.txt

# Autonomous submission. Set to true to let the agent press Submit after it
# fills every required answer from the saved profile/answer library and the
# form reports no errors. CAPTCHA and identity-verification pages still stop.
# Automatic submission requires the strict verified gate below.
AUTO_SUBMIT=false

# "profile" means form answers and navigation are deterministic: they come
# only from UserProfile and data/profile_answers.json. Claude is used only to
# tailor the resume/CV for the job. Set "claude" to restore assisted planning.
FORM_ANSWER_MODE=profile

# Which resume an application gets. "tailored" (the default) attaches the
# resume Claude tailored to this job -- the one the submit gate verifies.
# "master" attaches your standard resume at assets/master_resume.pdf instead.
RESUME_SOURCE=tailored

# What the agent does with a country, state or city the SITE filled in (a
# resume parser's guess, the first entry of a list) when it contradicts your
# profile. "correct" (the default) puts it right from your profile and lists
# the change at hand-over; "leave" keeps the site's value and lists it for you
# to fix. A value YOU typed or chose is never changed under either setting.
SITE_PREFILL_POLICY=correct

# Off by default. Set true only if Claude should also generate a cover letter
# for a form that asks for one. Resume/CV tailoring is always enabled.
GENERATE_COVER_LETTERS=false

# Which browser the agent drives. "chrome" is real Google Chrome as installed
# (the same one in your taskbar), so employers' forms behave exactly as they do
# for you. Set "chromium" to use the build Playwright ships instead. If Chrome
# is not installed, the agent falls back to it by itself.
BROWSER_CHANNEL=chrome

# Where that browser keeps its profile -- cookies, saved logins, the Google
# account it is signed into. The default is ./browser_profile, which belongs to
# the agent alone.
#
# You CAN point this at your own Chrome profile to reuse the logins you already
# have:
#     BROWSER_PROFILE_DIR=C:/Users/<you>/AppData/Local/Google/Chrome/User Data
# but a profile can only be open in one browser at a time, so Chrome must be
# fully closed first (check the tray) -- and every application run then reads
# and writes your real browsing profile. The separate profile avoids both.
# BROWSER_PROFILE_DIR=
