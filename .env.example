# Copy this file to .env and fill in your Anthropic API key.
# Do NOT put a LinkedIn/Indeed/Dice password here -- those three are
# hard-blocked from scripted login regardless of what's in this file.
# See SETUP_GUIDE.md.

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Employer ATS account (Workday/Greenhouse/Lever/iCIMS) credentials only --
# a dedicated password you use across these employer-owned application
# portals, NOT your email password and NOT a LinkedIn/Indeed/Dice password.
ATS_EMAIL=you@example.com
ATS_PASSWORD=

# Optional overrides:
# RESUME_PATH=./data/resume.pdf
# JOB_QUEUE_PATH=./data/job_queue.txt

# Verified auto-submit. Leave unset/false and the agent always stops before
# Submit. Set to true and it may submit ONLY when every required field exactly
# matches your approved profile/resume data, the job and documents match the
# tracked application, and nothing uncertain is on the page.
AUTO_SUBMIT_VERIFIED_ONLY=false
